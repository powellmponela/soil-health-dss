   photoshop:LegacyIPTCDigest="9DF0D476CCF30F01B51CD5DFE5105919"
   photoshop:Instructions="&amp;nbsp;"
   photoshop:City="&amp;nbsp;"
   photoshop:Country="Yemen"
   photoshop:Headline="&amp;nbsp;"
   photoshop:Credit="Â©FAO/Rosetta Messori"
   photoshop:Source="&amp;nbsp;"
   photoshop:ColorMode="4"
   dc:format="application/vnd.adobe.photoshop"
