   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FAO. Editorial use only. Photo credit must be given.</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">30 October 2013, KIROKA, TANZANIA  -  Farmers measure in preparation for a new contour ridge, called a Fanya Chini in Kiswahili, in Kiroka on October 30. At left is Mwinyi Mvua Nasoro Sembe, chairman of the soil conservation group. An FAO project to strengthen capacity of farms for climate change is underway in Kiroka, Tanzania.</rdf:li>
    </rdf:Alt>
   </dc:description>
