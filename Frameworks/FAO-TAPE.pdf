    xmlns:xmp="http://ns.adobe.com/xap/1.0/"
    xmlns:tiff="http://ns.adobe.com/tiff/1.0/"
    xmlns:exif="http://ns.adobe.com/exif/1.0/"
   photoshop:LegacyIPTCDigest="41474D740FBE26AD917C2C59AC7AC04C"
   photoshop:Instructions="&amp;nbsp;"
   photoshop:City="&amp;nbsp;"
   photoshop:Country="NEPAL"
   photoshop:Headline="Project: reducing vulnerability and increasing adaptive capacity to respond to impacts of climate change and variability for sustainable livelihoods in agriculture sector."
   photoshop:Credit="Â©Chris Steele-Perkins/Magnum Ph"
   photoshop:Source="FAO: photo-library@fao.org"
   photoshop:ColorMode="4"
   dc:format="application/vnd.adobe.photoshop"
   xmpMM:DocumentID="adobe:docid:photoshop:eab82cf9-6168-117d-96f2-985304d0855b"
   xmpMM:InstanceID="xmp.iid:0f8ce54e-12bf-4fd5-b7d1-1493bd266242"
   xmpMM:OriginalDocumentID="C23C612C4108083E1BC9EAFE74A785BB"
