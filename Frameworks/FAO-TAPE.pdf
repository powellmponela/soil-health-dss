     <rdf:li xml:lang="x-default">FAO. Editorial use only. Photo credit must be given.</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A man waters a vegetable field in Lubumbashi, Katanga province, Democratic Republic of Congo on Wednesday June 29, 2011. As part of its urban and peri-urban horticulture project, the FAO has provided farmers with improved-variety seeds, and has rehabilitated irrigation and flood-prevention infrastructures.&amp;#xA;</rdf:li>
    </rdf:Alt>
   </dc:description>
