      stEvt:softwareAgent="Adobe Photoshop CS5 Macintosh"
      stEvt:changed="/"/>
     <rdf:li
      stEvt:action="saved"
      stEvt:instanceID="xmp.iid:07801174072068119965A579DB91C71D"
      stEvt:when="2014-02-11T08:37:31+01:00"
      stEvt:softwareAgent="Adobe Photoshop CS5 Macintosh"
      stEvt:changed="/"/>
    </rdf:Seq>
   </xmpMM:History>
   <xmpMM:DerivedFrom
    stRef:instanceID="xmp.iid:4BA3F6361A206811822A8667CABC150E"
    stRef:documentID="xmp.did:4BA3F6361A206811822A8667CABC150E"
    stRef:originalDocumentID="D8E372ADE81DC8AEA2FAEF8369C7A83B"/>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Title: "Western Somaliland, 2013"&#xA;&#xA;A woman clutches her child as she reaches down into a catchment shared by a series of scattered homes in the desert northwest of Somalia. Lack of easy access to clean water divides the time women can spend on other activities, forces young girls to spend hours trekking across harsh terrain to gather water and ultimately jeopardizes the health of children, who suffer the worst effects of unclean sources of water. Diarrhea is a preventable illness caused by unclean water sources and is one of the leading causes of death among children worldwide.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <crs:ToneCurve>
    <rdf:Seq>
     <rdf:li>0, 0</rdf:li>
     <rdf:li>255, 255</rdf:li>
    </rdf:Seq>
   </crs:ToneCurve>
   <crs:ToneCurveRed>
