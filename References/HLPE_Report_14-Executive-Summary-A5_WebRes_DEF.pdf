    xmlns:xmp="http://ns.adobe.com/xap/1.0/"
   photoshop:LegacyIPTCDigest="7DC9741DB120529E660F57D338AC3E80"
   photoshop:DateCreated="2011-08-24"
   photoshop:City="Kyuso"
   photoshop:Country="KENYA"
   photoshop:Headline="Horn of Africa Crisis"
   photoshop:Credit="©FAO/Thomas Hug"
   photoshop:Source="FAO: photo-library@fao.org"
   photoshop:ColorMode="3"
   photoshop:ICCProfile="sRGB IEC61966-2.1"
   photoshop:Instructions="&amp;nbsp;"
   dc:format="image/jpeg"
   xmpMM:DocumentID="xmp.did:B4FCDA7C23B7E211ABC3FECC33F6F35D"
   xmpMM:InstanceID="xmp.iid:B5EF84ED7EC7E2119188B92A76345FDB"
   xmpMM:OriginalDocumentID="E1A2369E6EE3EDD49B8A2AC9C85F21E0"
   xmp:CreateDate="2013-05-07T14:49:05+02:00"
   xmp:ModifyDate="2013-05-28T12:11:52+02:00"
   xmp:MetadataDate="2013-05-28T12:11:52+02:00"
   xmp:CreatorTool="Adobe Photoshop CS6 (Windows)">
   <photoshop:DocumentAncestors>
    <rdf:Bag>
     <rdf:li>4B33F1B918BA0DCB08466B3A38CEC2E6</rdf:li>
     <rdf:li>88D2BE8011ABFD88B1C763DCFB0201D0</rdf:li>
     <rdf:li>A42A4D360FBBBA36C5467279E1D3A6FB</rdf:li>
     <rdf:li>A913F5865BD30EDF70CAAD3E5286F2B9</rdf:li>
     <rdf:li>E1A2369E6EE3EDD49B8A2AC9C85F21E0</rdf:li>
     <rdf:li>xmp.did:B4FCDA7C23B7E211ABC3FECC33F6F35D</rdf:li>
    </rdf:Bag>
   </photoshop:DocumentAncestors>
   <dc:subject>
    <rdf:Bag/>
   </dc:subject>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FAO. Editorial use only. Photo credit must be given.</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">24 August 2011, Kyuso - A beneficiary of FAOs voucher-for-work project in drought-prone eastern Kenya. Most people in these arid and semi-arid parts of eastern Kenya survive by farming small plots of land and raising livestock. They depend on the rains to grow food; however, consecutive years of uneven rainfall means farmers have not had a decent harvest for several seasons, leaving them more food insecure and cash poor. &amp;#xA;&amp;#xA;Farmers, working through Farmer Field and Life Schools (FFLS), are terracing at least one acre of their land so that fertile topsoil is not swept away with the rains. Likewise, they are constructing sand dams in dry riverbeds to capture and retain water that would otherwise be lost to runoff. Farmers are given a voucher in exchange for each day of work. Half of the voucher can be redeemed for food at select local traders, while the other half is used to buy building materials for the community sand dams. &amp;#xA;</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">PO_KEN_0692</rdf:li>
    </rdf:Alt>
   </dc:title>
